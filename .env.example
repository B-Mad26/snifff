# ---- Database ----
DATABASE_URL=postgresql://snifff:snifff@localhost:5432/snifff?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- JWT ----
JWT_ACCESS_SECRET=replace-me-32-byte-random
JWT_REFRESH_SECRET=replace-me-32-byte-random
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ---- Twilio (phone OTP) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=

# ---- OAuth ----
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---- Storage (R2 / S3) ----
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=snifff-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
CDN_BASE_URL=https://cdn.snifff.app

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_GOLD_MONTHLY=
STRIPE_PRICE_GOLD_YEARLY=
STRIPE_PRICE_BREEDER_MONTHLY=
STRIPE_PRICE_BREEDER_YEARLY=

# ---- AI ----
ANTHROPIC_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=snifff-pets
REPLICATE_API_TOKEN=

# ---- Moderation ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PERSPECTIVE_API_KEY=

# ---- Push ----
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=

# ---- App ----
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001
NODE_ENV=development
LOG_LEVEL=debug
SENTRY_DSN=
